{
  "name": "artzys-studio-nextjs",
  "version": "1.0.0-rc.1",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && node node_modules/next/dist/bin/next build",
    "postbuild": "node scripts/copy-output.js",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "eslint .",
    "pages:build": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && node node_modules/next/dist/bin/next build",
    "catalogue:import": "node scripts/import-erp-products.mjs",
    "test:gifts": "tsx --test tests/gift-engine.test.ts",
    "test:caricatures": "tsx --test tests/caricature-engine.test.ts",
    "test:name-plates": "tsx --test tests/name-plate-pricing.test.ts",
    "test:creative": "tsx --test tests/name-plate-pricing.test.ts tests/caricature-pricing.test.ts",
    "test:erp": "tsx --test tests/storefront-erp-router.test.ts",
    "test:artzyai": "tsx --test tests/artzyai-proxy.test.ts"
  },
  "dependencies": {
    "next": "16.3.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "wrangler": "^4.105.0"
  }
}
